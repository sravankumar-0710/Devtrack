+
+const CLIPBOARD_TRACKS = [
+  { key: "t1", label: "Foundations", icon: <BookOpen size={11} />, color: "#93C5FD" },
+  { key: "t2", label: "Web Roadmap", icon: <Code2    size={11} />, color: "#6EE7B7" },
